<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="external" path="*"/>
        <!-- see backupscheme.xml: keystore encrypted credentials cannot survive the trip -->
        <exclude
            domain="sharedpref"
            path="com.auth0.authentication.storage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="external" path="*"/>
        <exclude
            domain="sharedpref"
            path="com.auth0.authentication.storage.xml" />
    </device-transfer>
</data-extraction-rules>
